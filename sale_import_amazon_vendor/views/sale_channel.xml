<odoo>

    <record model="ir.ui.view" id="sale_channel_form_view">
        <field name="name">sale.channel.form (in sale_import_amazon_vendor)</field>
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_import_amazon_base.sale_channel_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_import_amazon']" position="inside">
                <button
                    name="amazon_vendor_import_orders_chunk"
                    string="Import Amazon Orders"
                    type="object"
                    class="btn btn-primary col-6 col-lg-3"
                />
            </xpath>
            <xpath expr="//group[@name='amazon_data']" position="inside">
                <field name="date_filtering_type" />
                <field name="date_filtering" />
            </xpath>
        </field>
    </record>



</odoo>
