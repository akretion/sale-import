<odoo>

    <record model="ir.ui.view" id="sale_channel_form_view">
        <field name="name">sale.channel.form (in sale_import_amazon_base)</field>
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_import_base.sale_channel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_import_base']/.." position="after">
                <group
                    name="sale_import_amazon"
                    string="Amazon Import Parameters"
                    attrs="{'invisible': [('is_amazon_channel', '=', False)]}"
                >
                    <group name="amazon_credentials" groups="base.group_system">
                        <field name="lwa_appid" />
                        <field name="sp_api_refresh_token" />
                        <field name="lwa_client_secret" />
                    </group>
                    <group name="amazon_data">
                        <field
                            name="marketplace_ids"
                            widget="many2many_tags"
                            domain="[('country_code','!=',False)]"
                        />
                        <field name="is_amazon_channel" invisible="1" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>



</odoo>
